---
// Fila de iconos circulares (stack, habilidades o enlaces rápidos) definida en site.quickItems.
import { site } from "../data/site";
import Icon from "./Icon.astro";
---

<ul class="skills" aria-label="Habilidades" data-reveal style="--reveal-delay: 120ms">
  {
    site.quickItems.map((item) =>
      item.href ? (
        <li>
          <a class="item" href={item.href}>
            <span class="circle">
              <Icon name={item.icon} size={24} />
            </span>
            <span class="label">{item.label}</span>
          </a>
        </li>
      ) : (
        <li>
          {/* tabindex para que el tooltip también aparezca con teclado */}
          <span class="item" tabindex="0">
            <span class="circle">
              <Icon name={item.icon} size={24} />
            </span>
            <span class="label">{item.label}</span>
          </span>
        </li>
      ),
    )
  }
</ul>

<style>
  .skills {
    display: flex;
    justify-content: space-between;
    max-width: 760px;
    margin: clamp(3.5rem, 8vw, 5.5rem) auto 0;
  }

  .item {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    border-radius: 50%;
  }

  .circle {
    display: grid;
    place-items: center;
    width: clamp(52px, 14vw, 68px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--surface);
    color: var(--accent-ink);
    box-shadow: var(--shadow-sm), inset 0 0 0 1px var(--border);
    transition:
      var(--theme-transition),
      transform 0.3s var(--ease);
  }

  .item:hover .circle,
  .item:focus-visible .circle {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md), inset 0 0 0 1px color-mix(in srgb, var(--accent) 40%, transparent);
  }

  /* Pantallas táctiles: etiqueta visible debajo del círculo */
  .label {
    max-width: 9ch;
    font-size: 0.75rem;
    line-height: 1.25;
    text-align: center;
    color: var(--text-2);
  }

  /* Con ratón: la etiqueta pasa a ser un tooltip */
  @media (hover: hover) and (pointer: fine) {
    .label {
      position: absolute;
      bottom: calc(100% + 10px);
      left: 50%;
      max-width: none;
      padding: 0.35rem 0.7rem;
      border-radius: var(--radius-pill);
      background: var(--text);
      color: var(--bg);
      font-size: 0.8125rem;
      font-weight: 500;
      white-space: nowrap;
      pointer-events: none;
      opacity: 0;
      transform: translate(-50%, 4px);
      transition:
        opacity 0.2s ease,
        transform 0.2s var(--ease);
    }

    .item:hover .label,
    .item:focus-visible .label {
      opacity: 1;
      transform: translate(-50%, 0);
    }
  }
</style>
