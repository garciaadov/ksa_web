---
// Proyectos: rejilla de tarjetas pequeñas (imagen, nombre y "Más información").
// Al pulsar una tarjeta se abre su ficha completa en una ventana con el fondo desenfocado:
// icono, nombre y versión, descripción, descargas por sistema operativo y enlace al repositorio.
// Datos en `projects` de src/data/site.ts. Si la lista está vacía se muestra "Próximamente...".
import { Image } from "astro:assets";
import { projects, t, tr, type Lang, type OS } from "../data/site";
import Icon, { type IconName } from "./Icon.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const text = t[lang].projects;

/** Nombre e icono de cada sistema operativo en los botones de descarga. */
const osInfo: Record<OS, { name: string; icon: IconName }> = {
  windows: { name: "Windows", icon: "windows" },
  macos: { name: "macOS", icon: "apple" },
  linux: { name: "Linux", icon: "linux" },
};
---

<section id="proyectos" class="section projects" aria-labelledby="projects-title">
  <div class="container">
    <header class="head" data-reveal>
      <p class="eyebrow">{text.eyebrow}</p>
      <h2 id="projects-title" class="section-title">{text.title}</h2>
      {projects.length === 0 && <p class="section-lead">{text.empty}</p>}
    </header>

    {
      projects.length > 0 && (
        <ul class="grid">
          {projects.map(({ title, tagline, version, description, status, icon, repo, downloads, tags }, index) => (
            <li data-reveal style={`--reveal-delay: ${index * 90}ms`}>
              {/* ---- Tarjeta pequeña: toda ella es un botón que abre la ficha ---- */}
              <button type="button" class="card" aria-haspopup="dialog" data-open-project={`proyecto-${index}`}>
                <span class="thumb">
                  {icon ? (
                    <Image src={icon} alt="" width={160} height={160} densities={[1, 2]} />
                  ) : (
                    <Icon name="clock" size={40} />
                  )}
                  {status !== "publicado" && <span class="pill status floating">{text.status[status]}</span>}
                </span>
                <span class="card-name">{title}</span>
                <span class="card-tagline">{tr(tagline, lang)}</span>
                <span class="card-cta">
                  {text.openDetails}
                  <Icon name="arrowUpRight" size={14} />
                </span>
              </button>

              {/* ---- Ficha completa ---- */}
              <dialog id={`proyecto-${index}`} class="modal" aria-labelledby={`proyecto-${index}-titulo`}>
                <article class="detail">
                  <button type="button" class="close" aria-label={text.close} data-close-project>
                    <Icon name="close" size={20} />
                  </button>

                  <div class="intro">
                    <div class="app-icon">
                      {icon ? (
                        <Image src={icon} alt="" width={88} height={88} densities={[1, 2]} />
                      ) : (
                        <Icon name="clock" size={32} />
                      )}
                    </div>

                    <div class="info">
                      <div class="name">
                        <h3 id={`proyecto-${index}-titulo`}>{title}</h3>
                        {version && <span class="pill version">{version}</span>}
                        {status !== "publicado" && <span class="pill status">{text.status[status]}</span>}
                      </div>
                      <p class="desc">{tr(description, lang)}</p>
                      {tags && tags.length > 0 && (
                        <ul class="tags" aria-label={text.tagsLabel}>
                          {tags.map((tag) => (
                            <li>{tag}</li>
                          ))}
                        </ul>
                      )}
                    </div>
                  </div>

                  {downloads && downloads.length > 0 && (
                    <div class="downloads">
                      <p class="label">{text.downloadsLabel}</p>
                      <ul>
                        {downloads.map(({ os, href, note }) => (
                          <li>
                            <a class="download" href={href}>
                              <Icon name={osInfo[os].icon} size={22} class="os-icon" />
                              <span class="text">
                                <span class="os">
                                  <span class="sr-only">{text.downloadFor} </span>
                                  {osInfo[os].name}
                                </span>
                                <span class="note">{tr(note, lang)}</span>
                              </span>
                              <Icon name="download" size={18} class="dl-icon" />
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}

                  {repo && (
                    <a class="more" href={repo}>
                      <Icon name="github" size={18} />
                      {text.moreInfo}
                      <Icon name="arrowUpRight" size={16} class="arrow" />
                    </a>
                  )}
                </article>
              </dialog>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<script>
  // Abre la ficha al pulsar su tarjeta. Escape la cierra de forma nativa (<dialog>);
  // además se cierra con la ✕ y al pulsar fuera de la ficha (sobre el fondo desenfocado).
  document.querySelectorAll<HTMLButtonElement>("[data-open-project]").forEach((card) => {
    const dialog = document.getElementById(card.dataset.openProject ?? "");
    if (!(dialog instanceof HTMLDialogElement)) return;

    card.addEventListener("click", () => dialog.showModal());
    dialog.querySelector("[data-close-project]")?.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (event) => {
      // El <dialog> ocupa solo el fondo; la ficha es el <article> de dentro
      if (event.target === dialog) dialog.close();
    });
  });
</script>

<style>
  .projects {
    padding-top: clamp(3rem, 8vw, 5rem);
  }

  .head {
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  /* ---- Rejilla de tarjetas pequeñas: 2 en móvil, 3 en tablet, 4 en escritorio ---- */
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(0.75rem, 2vw, 1.25rem);
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .card {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    padding: 0.6rem 0.6rem 1rem;
    border: 0;
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-sm), inset 0 0 0 1px var(--border);
    text-align: left;
    cursor: pointer;
    transition:
      var(--theme-transition),
      transform 0.3s var(--ease);
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md), inset 0 0 0 1px var(--border);
  }

  /* Imagen cuadrada, como la foto de un artículo */
  .thumb {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    margin-bottom: 0.85rem;
    border-radius: calc(var(--radius-lg) - 6px);
    background: #ffffff;
    color: var(--accent-ink);
    box-shadow: inset 0 0 0 1px var(--border);
    overflow: hidden;
  }

  .thumb :global(img) {
    width: 52%;
    height: 52%;
    object-fit: contain;
    transition: transform 0.4s var(--ease);
  }

  .card:hover .thumb :global(img) {
    transform: scale(1.06);
  }

  .card-name {
    padding-inline: 0.4rem;
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .card-tagline {
    padding-inline: 0.4rem;
    font-size: 0.875rem;
    color: var(--text-2);
  }

  .card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    align-self: flex-start;
    margin: 0.85rem 0.4rem 0;
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-pill);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent-ink);
    background: var(--accent-soft);
    transition: background-color 0.2s ease;
  }

  .card:hover .card-cta {
    background: color-mix(in srgb, var(--accent) 18%, transparent);
  }

  /* ---- Ventana con la ficha completa ---- */
  .modal {
    width: min(760px, calc(100% - 2rem));
    max-height: calc(100dvh - 2rem);
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: var(--radius-xl);
    background: transparent;
    color: var(--text);
    overflow: visible;
  }

  /* Fondo de la página desenfocado mientras la ficha está abierta */
  .modal::backdrop {
    background: rgb(0 0 0 / 0.35);
    -webkit-backdrop-filter: blur(10px) saturate(140%);
    backdrop-filter: blur(10px) saturate(140%);
  }

  .modal[open] {
    animation: modal-in 0.3s var(--ease);
  }

  .modal[open]::backdrop {
    animation: backdrop-in 0.3s ease;
  }

  @keyframes modal-in {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.97);
    }
  }

  @keyframes backdrop-in {
    from {
      opacity: 0;
    }
  }

  /* Evita que la página de detrás se desplace con la ficha abierta */
  :global(html:has(dialog[open])) {
    overflow: hidden;
  }

  .detail {
    position: relative;
    display: grid;
    gap: clamp(1.5rem, 3vw, 2rem);
    max-height: calc(100dvh - 2rem);
    padding: clamp(1.25rem, 3.5vw, 2.25rem);
    border-radius: var(--radius-xl);
    background: var(--surface);
    box-shadow: var(--shadow-md), inset 0 0 0 1px var(--border);
    overflow-y: auto;
  }

  .close {
    position: absolute;
    top: 0.85rem;
    right: 0.85rem;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: var(--surface-2);
    color: var(--text-2);
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .close:hover {
    color: var(--text);
    background: var(--accent-soft);
  }

  .intro {
    display: grid;
    gap: 1.25rem;
    align-items: start;
  }

  @media (min-width: 640px) {
    .intro {
      grid-template-columns: auto 1fr;
      gap: 1.75rem;
    }
  }

  /* Icono de la app sobre un recuadro blanco, como en un dock */
  .app-icon {
    display: grid;
    place-items: center;
    width: 88px;
    aspect-ratio: 1;
    padding: 14px;
    border-radius: 24px;
    background: #ffffff;
    color: var(--accent-ink);
    box-shadow: var(--shadow-sm), inset 0 0 0 1px var(--border);
  }

  .app-icon :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    padding-right: 2.5rem;
  }

  h3 {
    font-size: clamp(1.75rem, 3.5vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .pill {
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-pill);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .version {
    color: var(--accent-ink);
    background: var(--accent-soft);
  }

  .status {
    color: var(--text-2);
    background: var(--surface-2);
  }

  .floating {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    font-size: 0.75rem;
  }

  .desc {
    margin-top: 0.6rem;
    font-size: 1.0625rem;
    color: var(--text-2);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1rem;
  }

  .tags li {
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-pill);
    font-size: 0.75rem;
    color: var(--text-2);
    background: var(--surface-2);
  }

  /* ---- Descargas ---- */
  .downloads {
    padding-top: clamp(1.25rem, 3vw, 1.75rem);
    border-top: 1px solid var(--border);
  }

  .label {
    margin-bottom: 0.75rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  .downloads ul {
    display: grid;
    gap: 0.75rem;
  }

  @media (min-width: 720px) {
    .downloads ul {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .download {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    height: 100%;
    min-height: 64px;
    padding: 0.85rem 1rem;
    border-radius: var(--radius-lg);
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--border);
    transition:
      var(--theme-transition),
      transform 0.25s var(--ease);
  }

  .download:hover {
    transform: translateY(-2px);
    background: var(--accent-soft);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 35%, transparent);
  }

  .download :global(.os-icon) {
    flex-shrink: 0;
    color: var(--text);
  }

  .text {
    display: grid;
    min-width: 0;
  }

  .os {
    font-weight: 600;
  }

  .note {
    font-size: 0.8125rem;
    color: var(--text-2);
  }

  .download :global(.dl-icon) {
    flex-shrink: 0;
    margin-left: auto;
    color: var(--accent-ink);
    transition: transform 0.25s var(--ease);
  }

  .download:hover :global(.dl-icon) {
    transform: translateY(2px);
  }

  /* ---- Enlace al repositorio ---- */
  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    justify-self: start;
    min-height: 44px;
    font-weight: 500;
    color: var(--accent-ink);
  }

  .more :global(.arrow) {
    transition: transform 0.25s var(--ease);
  }

  .more:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .more:hover :global(.arrow) {
    transform: translate(2px, -2px);
  }
</style>
