---
// Proyectos: rejilla de tarjetas generada desde `projects` en src/data/site.ts.
// Si la lista está vacía solo se muestra el título y "Próximamente...".
import { Image } from "astro:assets";
import { projects, type ProjectStatus } from "../data/site";
import Icon from "./Icon.astro";

const statusLabel: Record<ProjectStatus, string> = {
  publicado: "Publicado",
  "en-desarrollo": "En desarrollo",
  proximamente: "Próximamente",
};
---

<section id="proyectos" class="section projects" aria-labelledby="projects-title">
  <div class="container">
    <header class="head" data-reveal>
      <p class="eyebrow">Proyectos</p>
      <h2 id="projects-title" class="section-title">Market de proyectos.</h2>
      {projects.length === 0 && <p class="section-lead">Próximamente...</p>}
    </header>

    {
      projects.length > 0 && (
        <ul class="grid">
          {projects.map(({ title, description, status, image, href, tags }, index) => (
            <li data-reveal style={`--reveal-delay: ${index * 90}ms`}>
              <article class="card">
                <div class="media">
                  {
                    image ? (
                      <Image src={image.src} alt={image.alt} widths={[400, 640, 800]} sizes="(min-width: 1024px) 260px, (min-width: 640px) 45vw, 90vw" />
                    ) : (
                      // Placeholder: mini ventana con contenido esquemático
                      <div class="placeholder" aria-hidden="true">
                        <div class="window">
                          <div class="dots">
                            <span />
                            <span />
                            <span />
                          </div>
                          <div class="sk sk-title" />
                          <div class="sk sk-line" />
                          <div class="sk sk-line short" />
                          <div class="sk-blocks">
                            <div class="sk" />
                            <div class="sk" />
                          </div>
                        </div>
                      </div>
                    )
                  }
                  <span class:list={["badge", `badge--${status}`]}>
                    {status === "proximamente" && <Icon name="clock" size={14} />}
                    {statusLabel[status]}
                  </span>
                </div>

                <div class="body">
                  <h3 class="title">
                    {
                      href ? (
                        <a href={href} class="stretched">
                          {title}
                          <Icon name="arrowUpRight" size={16} class="arrow" />
                        </a>
                      ) : (
                        title
                      )
                    }
                  </h3>
                  <p class="desc">{description}</p>
                  {
                    tags && tags.length > 0 && (
                      <ul class="tags" aria-label="Tecnologías">
                        {tags.map((tag) => (
                          <li>{tag}</li>
                        ))}
                      </ul>
                    )
                  }
                </div>
              </article>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  .projects {
    padding-top: clamp(3rem, 8vw, 5rem);
  }

  .head {
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  /* 1 columna en móvil, 2 en tablet, 4 en escritorio */
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* ---- Tarjeta de proyecto ---- */
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 10px;
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-sm), inset 0 0 0 1px var(--border);
    transition:
      var(--theme-transition),
      transform 0.35s var(--ease);
  }

  .card:hover,
  .card:focus-within {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md), inset 0 0 0 1px var(--border);
  }

  .media {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: calc(var(--radius-lg) - 10px);
    overflow: hidden;
    background: var(--surface-2);
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---- Placeholder "Próximamente" ---- */
  .placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 14%;
    background:
      radial-gradient(circle at 1px 1px, color-mix(in srgb, var(--text) 10%, transparent) 1px, transparent 0) 0 0 / 14px 14px,
      radial-gradient(90% 90% at 80% 0%, var(--accent-soft), transparent 70%),
      var(--surface-2);
  }

  .window {
    display: grid;
    gap: 7px;
    width: 100%;
    padding: 10px 12px 12px;
    border-radius: 12px;
    background: var(--surface);
    box-shadow: var(--shadow-sm), 0 0 0 1px var(--border);
    transition: transform 0.5s var(--ease);
  }

  .card:hover .window {
    transform: translateY(-3px) scale(1.02);
  }

  .dots {
    display: flex;
    gap: 4px;
    margin-bottom: 4px;
  }

  .dots span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--text) 18%, transparent);
  }

  .sk {
    height: 7px;
    border-radius: 4px;
    background: linear-gradient(
        90deg,
        transparent 0%,
        color-mix(in srgb, var(--surface) 70%, transparent) 50%,
        transparent 100%
      )
      -150% 0 / 60% 100% no-repeat,
      color-mix(in srgb, var(--text) 9%, transparent);
    animation: shimmer 2.6s ease-in-out infinite;
  }

  .sk-title {
    width: 55%;
    height: 9px;
    background-color: color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .sk-line {
    width: 90%;
  }

  .sk-line.short {
    width: 65%;
  }

  .sk-blocks {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
    margin-top: 4px;
  }

  .sk-blocks .sk {
    height: 22px;
    border-radius: 6px;
  }

  @keyframes shimmer {
    to {
      background-position:
        250% 0,
        0 0;
    }
  }

  /* ---- Etiqueta de estado ---- */
  .badge {
    position: absolute;
    top: 10px;
    left: 10px;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0.65rem;
    border-radius: var(--radius-pill);
    font-size: 0.75rem;
    font-weight: 600;
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--shadow-sm);
  }

  .badge--proximamente {
    color: var(--accent-ink);
  }

  .badge--en-desarrollo {
    color: var(--text-2);
  }

  /* ---- Texto ---- */
  .body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1rem 0.6rem 0.6rem;
  }

  .title {
    font-size: 1.1875rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .title a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  /* El enlace del título cubre toda la tarjeta */
  .stretched::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
  }

  .stretched:focus-visible {
    outline: none;
  }

  .stretched:focus-visible::after {
    outline: 2px solid var(--accent-ink);
    outline-offset: 3px;
  }

  .title :global(.arrow) {
    color: var(--accent-ink);
    transition: transform 0.25s var(--ease);
  }

  .card:hover .title :global(.arrow) {
    transform: translate(2px, -2px);
  }

  .desc {
    font-size: 0.9375rem;
    color: var(--text-2);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.5rem;
  }

  .tags li {
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-pill);
    font-size: 0.75rem;
    color: var(--text-2);
    background: var(--surface-2);
  }
</style>
