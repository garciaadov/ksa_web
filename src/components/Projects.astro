---
// Proyectos: una tarjeta ancha por proyecto, generada desde `projects` en src/data/site.ts.
// Cada tarjeta: icono, nombre y versión, descripción, botones de descarga y enlace al repositorio.
// Si la lista está vacía solo se muestra el título y "Próximamente...".
import { Image } from "astro:assets";
import { projects, t, tr, type Lang, type OS } from "../data/site";
import Icon, { type IconName } from "./Icon.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const text = t[lang].projects;

/** Nombre e icono de cada sistema operativo en los botones de descarga. */
const osInfo: Record<OS, { name: string; icon: IconName }> = {
  windows: { name: "Windows", icon: "windows" },
  macos: { name: "macOS", icon: "apple" },
  linux: { name: "Linux", icon: "linux" },
};
---

<section id="proyectos" class="section projects" aria-labelledby="projects-title">
  <div class="container">
    <header class="head" data-reveal>
      <p class="eyebrow">{text.eyebrow}</p>
      <h2 id="projects-title" class="section-title">{text.title}</h2>
      {projects.length === 0 && <p class="section-lead">{text.empty}</p>}
    </header>

    {
      projects.length > 0 && (
        <ul class="list">
          {projects.map(({ title, version, description, status, icon, repo, downloads, tags }, index) => (
            <li data-reveal style={`--reveal-delay: ${index * 90}ms`}>
              <article class="card" aria-labelledby={`project-${index}`}>
                {/* Cabecera: icono + nombre, versión y descripción */}
                <div class="intro">
                  <div class="app-icon">
                    {icon ? (
                      <Image src={icon} alt="" width={88} height={88} densities={[1, 2]} />
                    ) : (
                      <Icon name="clock" size={32} />
                    )}
                  </div>

                  <div class="info">
                    <div class="name">
                      <h3 id={`project-${index}`}>{title}</h3>
                      {version && <span class="pill version">{version}</span>}
                      {status !== "publicado" && <span class="pill status">{text.status[status]}</span>}
                    </div>
                    <p class="desc">{tr(description, lang)}</p>
                    {tags && tags.length > 0 && (
                      <ul class="tags" aria-label={text.tagsLabel}>
                        {tags.map((tag) => (
                          <li>{tag}</li>
                        ))}
                      </ul>
                    )}
                  </div>
                </div>

                {/* Descargas: un botón por sistema operativo */}
                {downloads && downloads.length > 0 && (
                  <div class="downloads">
                    <p class="label">{text.downloadsLabel}</p>
                    <ul>
                      {downloads.map(({ os, href, note }) => (
                        <li>
                          <a class="download" href={href}>
                            <Icon name={osInfo[os].icon} size={22} class="os-icon" />
                            <span class="text">
                              <span class="os">
                                <span class="sr-only">{text.downloadFor} </span>
                                {osInfo[os].name}
                              </span>
                              <span class="note">{tr(note, lang)}</span>
                            </span>
                            <Icon name="download" size={18} class="dl-icon" />
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                {/* Pie: enlace al repositorio */}
                {repo && (
                  <a class="more" href={repo}>
                    <Icon name="github" size={18} />
                    {text.moreInfo}
                    <Icon name="arrowUpRight" size={16} class="arrow" />
                  </a>
                )}
              </article>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  .projects {
    padding-top: clamp(3rem, 8vw, 5rem);
  }

  .head {
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .list {
    display: grid;
    gap: 1.5rem;
  }

  /* ---- Tarjeta ---- */
  .card {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2rem);
    padding: clamp(1.25rem, 3.5vw, 2.25rem);
    border-radius: var(--radius-xl);
    background: var(--surface);
    box-shadow: var(--shadow-sm), inset 0 0 0 1px var(--border);
    transition: var(--theme-transition);
  }

  .intro {
    display: grid;
    gap: 1.25rem;
    align-items: start;
  }

  @media (min-width: 640px) {
    .intro {
      grid-template-columns: auto 1fr;
      gap: 1.75rem;
    }
  }

  /* Icono de la app sobre un recuadro blanco, como en un dock */
  .app-icon {
    display: grid;
    place-items: center;
    width: 88px;
    aspect-ratio: 1;
    padding: 14px;
    border-radius: 24px;
    background: #ffffff;
    color: var(--accent-ink);
    box-shadow: var(--shadow-sm), inset 0 0 0 1px var(--border);
  }

  .app-icon :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }

  h3 {
    font-size: clamp(1.75rem, 3.5vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .pill {
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-pill);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .version {
    color: var(--accent-ink);
    background: var(--accent-soft);
  }

  .status {
    color: var(--text-2);
    background: var(--surface-2);
  }

  .desc {
    margin-top: 0.6rem;
    max-width: 46rem;
    font-size: 1.0625rem;
    color: var(--text-2);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1rem;
  }

  .tags li {
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-pill);
    font-size: 0.75rem;
    color: var(--text-2);
    background: var(--surface-2);
  }

  /* ---- Descargas ---- */
  .downloads {
    padding-top: clamp(1.25rem, 3vw, 1.75rem);
    border-top: 1px solid var(--border);
  }

  .label {
    margin-bottom: 0.75rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  .downloads ul {
    display: grid;
    gap: 0.75rem;
  }

  @media (min-width: 860px) {
    .downloads ul {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .download {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    height: 100%;
    min-height: 64px;
    padding: 0.85rem 1rem;
    border-radius: var(--radius-lg);
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--border);
    transition:
      var(--theme-transition),
      transform 0.25s var(--ease);
  }

  .download:hover {
    transform: translateY(-2px);
    background: var(--accent-soft);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 35%, transparent);
  }

  .download :global(.os-icon) {
    flex-shrink: 0;
    color: var(--text);
  }

  .text {
    display: grid;
    min-width: 0;
  }

  .os {
    font-weight: 600;
  }

  .note {
    font-size: 0.8125rem;
    color: var(--text-2);
  }

  .download :global(.dl-icon) {
    flex-shrink: 0;
    margin-left: auto;
    color: var(--accent-ink);
    transition: transform 0.25s var(--ease);
  }

  .download:hover :global(.dl-icon) {
    transform: translateY(2px);
  }

  /* ---- Enlace al repositorio ---- */
  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    justify-self: start;
    min-height: 44px;
    font-weight: 500;
    color: var(--accent-ink);
  }

  .more :global(.arrow) {
    transition: transform 0.25s var(--ease);
  }

  .more:hover :global(.arrow) {
    transform: translate(2px, -2px);
  }

  .more:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
