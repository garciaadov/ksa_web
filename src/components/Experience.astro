---
// Experiencia: fila de logos circulares que se desplaza suavemente hacia la izquierda en bucle.
// Cada logo ocupa 1/4 del ancho, así que siempre se ven cuatro. Datos en src/data/experience.ts.
import { Image } from "astro:assets";
import { experience } from "../data/experience";
import { site } from "../data/site";
import { withBase } from "../lib/url";
import Icon from "./Icon.astro";

/** Logos visibles a la vez en la fila. */
const VISIBLE = 4;

// La pista contiene dos mitades idénticas y la animación desplaza exactamente una mitad,
// así el bucle no tiene saltos. Si hay menos logos que VISIBLE, se repiten para llenar la fila.
const repeat = Math.ceil(VISIBLE / Math.max(experience.length, 1));
const half = Array.from({ length: repeat }, () => experience).flat();
const track = [...half, ...half];
// Segundos por logo: velocidad constante sea cual sea el número de logos.
const duration = half.length * 6;
---

<section id="experiencia" class="section experience" aria-labelledby="experience-title">
  <div class="container">
    <header class="head" data-reveal>
      <p class="eyebrow">Experiencia</p>
      <h2 id="experience-title" class="section-title">Experiencia.</h2>
    </header>

    {
      experience.length > 0 && (
        <div data-reveal style="--reveal-delay: 120ms">
          {/* Lista accesible; la fila animada es solo visual */}
          <ul class="sr-only">
            {experience.map((item) => (
              <li>{item.role ? `${item.name}: ${item.role}` : item.name}</li>
            ))}
          </ul>

          <div class="marquee" aria-hidden="true" style={`--visible: ${VISIBLE}`}>
            <ul class="track" style={`--duration: ${duration}s`}>
              {track.map((item, index) => (
                <li class:list={["item", { copy: index >= experience.length }]}>
                  <span class="circle" style={`--logo-bg: ${item.background}; --scale: ${item.scale ?? 1}`}>
                    <Image src={item.logo} alt="" width={Math.round(256 * (item.scale ?? 1))} loading="lazy" />
                  </span>
                  <span class="label">{item.role ? `${item.name} · ${item.role}` : item.name}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      )
    }

    {
      site.cv && (
        <p class="more" data-reveal style="--reveal-delay: 180ms">
          <a href={withBase(site.cv)} download={site.cv}>
            <Icon name="download" size={16} />
            Más información · Descargar currículum (PDF)
          </a>
        </p>
      )
    }
  </div>
</section>

<style>
  .experience {
    padding-top: clamp(3rem, 8vw, 5rem);
    padding-bottom: clamp(2rem, 5vw, 3rem);
  }

  .head {
    margin-bottom: clamp(0.5rem, 2vw, 1rem);
  }

  .marquee {
    /* Las medidas de los logos se calculan sobre el ancho de la fila (unidades cqi) */
    container-type: inline-size;
    overflow: hidden;
    /* Espacio para el tooltip y la sombra; difuminado suave en los bordes */
    padding-block: 3.75rem 1.5rem;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 4%, #000 96%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 4%, #000 96%, transparent);
  }

  .track {
    display: flex;
    width: max-content;
    animation: scroll var(--duration, 24s) linear infinite;
  }

  /* Pausa al pasar el ratón para poder leer el tooltip */
  .marquee:hover .track {
    animation-play-state: paused;
  }

  @keyframes scroll {
    to {
      transform: translateX(-50%);
    }
  }

  .item {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    /* Cada logo ocupa exactamente 1/4 de la fila */
    width: calc(100cqi / var(--visible));
  }

  .circle {
    display: grid;
    place-items: center;
    width: min(132px, calc(100cqi / var(--visible) - 1.25rem));
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    background: var(--logo-bg);
    box-shadow: var(--shadow-sm), inset 0 0 0 1px var(--border);
    transition:
      transform 0.3s var(--ease),
      box-shadow 0.3s ease;
  }

  .circle :global(img) {
    width: calc(100% * var(--scale));
    height: calc(100% * var(--scale));
    object-fit: contain;
  }

  .item:hover .circle {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md), inset 0 0 0 1px color-mix(in srgb, var(--accent) 40%, transparent);
  }

  /* Pantallas táctiles: nombre visible debajo del círculo */
  .label {
    max-width: 11ch;
    font-size: 0.75rem;
    line-height: 1.25;
    text-align: center;
    color: var(--text-2);
  }

  /* Con ratón: el nombre aparece como tooltip */
  @media (hover: hover) and (pointer: fine) {
    .label {
      position: absolute;
      bottom: calc(100% + 10px);
      left: 50%;
      max-width: none;
      padding: 0.35rem 0.7rem;
      border-radius: var(--radius-pill);
      background: var(--text);
      color: var(--bg);
      font-size: 0.8125rem;
      font-weight: 500;
      white-space: nowrap;
      pointer-events: none;
      opacity: 0;
      transform: translate(-50%, 4px);
      transition:
        opacity 0.2s ease,
        transform 0.2s var(--ease);
    }

    .item:hover .label {
      opacity: 1;
      transform: translate(-50%, 0);
    }
  }

  /* Enlace discreto al currículum */
  .more {
    text-align: center;
  }

  .more a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    padding-inline: 0.75rem;
    border-radius: var(--radius-pill);
    font-size: 0.875rem;
    color: var(--text-2);
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }

  .more a:hover {
    color: var(--accent-ink);
    background: var(--accent-soft);
  }

  /* Movimiento reducido: fila estática, sin copias */
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      -webkit-mask-image: none;
      mask-image: none;
    }

    .track {
      flex-wrap: wrap;
      justify-content: center;
      row-gap: 1.5rem;
      width: auto;
      animation: none;
    }

    .item.copy {
      display: none;
    }
  }
</style>
