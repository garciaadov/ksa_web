---
// Cabecera fija y translúcida: logo, menú (hamburguesa en móvil) e interruptor claro/oscuro.
// El tema inicial lo aplica el script inline de Layout.astro; aquí solo se gestiona el cambio manual.
import { Image } from "astro:assets";
import { site } from "../data/site";
import Icon from "./Icon.astro";

// "/#id" funciona igual desde la portada (solo hace scroll) y desde /privacidad/
const links = [
  { id: "inicio", label: "Inicio" },
  { id: "experiencia", label: "Experiencia" },
  { id: "proyectos", label: "Proyectos" },
  { id: "contactos", label: "Contactos" },
];
---

<header class="site-header" data-header>
  <div class="container inner">
    <a class="logo" href="/#inicio">
      <Image src={site.logo} alt={`KSA: ${site.name}, ir al inicio`} width={40} height={40} densities={[1, 2]} loading="eager" />
    </a>

    <nav class="nav" aria-label="Principal">
      <button
        type="button"
        class="menu-button"
        aria-expanded="false"
        aria-controls="menu-principal"
        aria-label="Abrir menú"
        data-menu-button
      >
        <Icon name="menu" size={22} />
      </button>
      <ul id="menu-principal" class="nav-list" data-menu>
        {
          links.map((link) => (
            <li>
              <a href={`/#${link.id}`} data-nav-link={link.id}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button type="button" class="theme-toggle" role="switch" aria-checked="false" aria-label="Modo oscuro" data-theme-toggle>
      <span class="knob" aria-hidden="true"></span>
      <span class="slot sun"><Icon name="sun" size={16} /></span>
      <span class="slot moon"><Icon name="moon" size={15} /></span>
    </button>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const button = document.querySelector<HTMLButtonElement>("[data-menu-button]");
  const menu = document.querySelector<HTMLElement>("[data-menu]");
  const navLinks = document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]");

  // ---- Menú móvil ----
  function setMenu(open: boolean): void {
    if (!button || !menu) return;
    button.setAttribute("aria-expanded", String(open));
    button.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
    menu.classList.toggle("is-open", open);
  }

  button?.addEventListener("click", () => setMenu(button.getAttribute("aria-expanded") !== "true"));
  navLinks.forEach((link) => link.addEventListener("click", () => setMenu(false)));

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && button?.getAttribute("aria-expanded") === "true") {
      setMenu(false);
      button.focus();
    }
  });

  document.addEventListener("click", (event) => {
    if (header && event.target instanceof Node && !header.contains(event.target)) setMenu(false);
  });

  // ---- Sección activa + sombra del header al hacer scroll ----
  const sections = [...navLinks]
    .map((link) => document.getElementById(link.dataset.navLink ?? ""))
    .filter((el): el is HTMLElement => el !== null);

  function update(): void {
    header?.classList.toggle("is-scrolled", window.scrollY > 8);
    if (sections.length === 0) return;

    // La activa es la última sección cuyo inicio ha pasado el 35 % superior de la pantalla;
    // al llegar al final de la página, la última.
    const line = window.innerHeight * 0.35;
    const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4;
    let active = sections[0];
    for (const section of sections) {
      if (section.getBoundingClientRect().top <= line) active = section;
    }
    if (atBottom) active = sections[sections.length - 1];

    navLinks.forEach((link) => {
      if (link.dataset.navLink === active?.id) link.setAttribute("aria-current", "location");
      else link.removeAttribute("aria-current");
    });
  }

  let ticking = false;
  window.addEventListener(
    "scroll",
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        update();
        ticking = false;
      });
    },
    { passive: true },
  );
  window.addEventListener("resize", update, { passive: true });
  update();

  // ---- Interruptor claro / oscuro ----
  type Theme = "light" | "dark";
  const STORAGE_KEY = "theme";

  const root = document.documentElement;
  const systemDark = window.matchMedia("(prefers-color-scheme: dark)");
  const toggles = document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]");

  const current = (): Theme => (root.dataset.theme === "dark" ? "dark" : "light");

  // Solo se guarda (y se lee) la elección manual del usuario.
  function stored(): Theme | null {
    try {
      const value = localStorage.getItem(STORAGE_KEY);
      return value === "light" || value === "dark" ? value : null;
    } catch {
      return null;
    }
  }

  function apply(theme: Theme): void {
    root.dataset.theme = theme;
    toggles.forEach((btn) => btn.setAttribute("aria-checked", String(theme === "dark")));
  }

  apply(current());

  toggles.forEach((btn) =>
    btn.addEventListener("click", () => {
      const next: Theme = current() === "dark" ? "light" : "dark";
      apply(next);
      try {
        localStorage.setItem(STORAGE_KEY, next);
      } catch {
        // Almacenamiento no disponible (modo privado, bloqueado…): el cambio vale para esta visita.
      }
    }),
  );

  // Si el usuario no ha elegido, seguimos los cambios del sistema en vivo.
  systemDark.addEventListener("change", (event) => {
    if (!stored()) apply(event.matches ? "dark" : "light");
  });
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--header-h);
    background: var(--header-bg);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid transparent;
    transition: var(--theme-transition);
  }

  .site-header.is-scrolled {
    border-bottom-color: var(--border);
  }

  .inner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 100%;
  }

  .logo {
    display: inline-flex;
    border-radius: 10px;
    transition: transform 0.25s var(--ease);
  }

  .logo:hover {
    transform: scale(1.05);
  }

  .nav {
    margin-left: auto;
  }

  /* ---- Móvil: botón hamburguesa + panel desplegable ---- */
  .menu-button {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
  }

  .menu-button:hover {
    background: var(--accent-soft);
  }

  .nav-list {
    position: absolute;
    top: calc(var(--header-h) + 0.5rem);
    right: var(--gutter);
    left: var(--gutter);
    display: grid;
    gap: 0.25rem;
    padding: 0.5rem;
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-md), 0 0 0 1px var(--border);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px) scale(0.98);
    transform-origin: top right;
    transition:
      opacity 0.25s var(--ease),
      transform 0.25s var(--ease),
      visibility 0s linear 0.25s;
  }

  .nav-list.is-open {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }

  /* Sin JS el menú queda siempre visible en la página (no se puede abrir) */
  :global(html:not(.js)) .menu-button {
    display: none;
  }

  :global(html:not(.js)) .nav-list {
    position: static;
    display: flex;
    padding: 0;
    background: none;
    box-shadow: none;
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .nav-list a {
    display: block;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    font-size: 1.0625rem;
    color: var(--text);
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .nav-list a:hover {
    background: var(--surface-2);
  }

  .nav-list a[aria-current="location"] {
    color: var(--accent-ink);
    background: var(--accent-soft);
    font-weight: 600;
  }

  /* ---- Escritorio: enlaces en línea ---- */
  @media (min-width: 720px) {
    .menu-button {
      display: none;
    }

    .nav-list {
      position: static;
      display: flex;
      gap: 0.25rem;
      padding: 0;
      background: none;
      box-shadow: none;
      opacity: 1;
      visibility: visible;
      transform: none;
      transition: none;
    }

    .nav-list a {
      padding: 0.4rem 0.9rem;
      border-radius: var(--radius-pill);
      font-size: 0.9375rem;
      color: var(--text-2);
    }

    .nav-list a:hover {
      color: var(--text);
      background: transparent;
    }

    .inner {
      gap: 1rem;
    }
  }

  /* ---- Interruptor claro / oscuro ---- */
  .theme-toggle {
    --size: 30px;
    --pad: 3px;
    position: relative;
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    width: calc(var(--size) * 2 + var(--pad) * 2);
    height: calc(var(--size) + var(--pad) * 2);
    padding: var(--pad);
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--border);
    cursor: pointer;
    transition: var(--theme-transition);
  }

  /* Sin JS el interruptor no funcionaría: se oculta y manda el sistema */
  :global(html:not(.js)) .theme-toggle {
    display: none;
  }

  .slot {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: var(--size);
    height: var(--size);
    color: var(--text-2);
    transition: color 0.3s ease;
  }

  .knob {
    position: absolute;
    top: var(--pad);
    left: var(--pad);
    width: var(--size);
    height: var(--size);
    border-radius: 50%;
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    transition:
      transform 0.35s var(--ease),
      background-color 0.4s ease;
  }

  /* Claro: la bola está bajo el sol */
  .sun {
    color: var(--accent-ink);
  }

  /* Oscuro: la bola se desplaza bajo la luna */
  :global([data-theme="dark"]) .knob {
    transform: translateX(var(--size));
    background: var(--surface-2);
    box-shadow: 0 0 0 1px var(--border), var(--shadow-sm);
  }

  :global([data-theme="dark"]) .theme-toggle {
    background: var(--bg);
  }

  :global([data-theme="dark"]) .sun {
    color: var(--text-2);
  }

  :global([data-theme="dark"]) .moon {
    color: var(--accent-ink);
  }

  .theme-toggle:hover {
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 35%, transparent);
  }
</style>
