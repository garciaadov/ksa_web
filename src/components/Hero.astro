---
// Sección de inicio: foto + titular y presentación.
import { Image } from "astro:assets";
import { site, t, type Lang } from "../data/site";

interface Props {
  lang: Lang;
}

const hero = t[Astro.props.lang].hero;
---

<section id="inicio" class="hero" aria-labelledby="hero-title">
  <div class="container">
    <div class="grid">
      <div class="photo" data-reveal>
        <Image
          src={site.photo}
          alt={hero.photoAlt}
          widths={[320, 480, 720]}
          sizes="(min-width: 860px) 360px, 280px"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <div class="copy">
        <p class="eyebrow">{hero.role}</p>
        <h1 id="hero-title">{hero.headline}</h1>
        <p class="intro">{hero.intro}</p>
        <div class="actions">
          <a class="btn btn-primary" href="#proyectos">{hero.ctaProjects}</a>
          <a class="btn btn-ghost" href="#contactos">{hero.ctaContact}</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: calc(var(--header-h) + clamp(2.5rem, 8vw, 6rem));
    padding-bottom: clamp(3rem, 8vw, 5rem);
  }

  /* Móvil primero: foto y texto apilados */
  .grid {
    display: grid;
    gap: 2.5rem;
    justify-items: center;
    text-align: center;
  }

  .photo {
    width: min(280px, 72vw);
    aspect-ratio: 1;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  h1 {
    font-size: clamp(2.5rem, 7vw, 4.75rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.04;
  }

  .intro {
    margin-top: 1.25rem;
    max-width: 34rem;
    font-size: clamp(1.125rem, 1.8vw, 1.3125rem);
    color: var(--text-2);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  /* Escritorio: foto a la izquierda, texto a la derecha */
  @media (min-width: 860px) {
    .grid {
      grid-template-columns: minmax(260px, 360px) 1fr;
      gap: clamp(3rem, 6vw, 5.5rem);
      align-items: center;
      justify-items: start;
      text-align: left;
    }

    .photo {
      width: 100%;
    }

    .actions {
      justify-content: flex-start;
    }
  }
</style>
