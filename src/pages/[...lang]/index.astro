---
// Portada. Se genera una vez por idioma: ksaga.es/ (español) y ksaga.es/en/ (inglés).
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Hero from "../../components/Hero.astro";
import Experience from "../../components/Experience.astro";
import Projects from "../../components/Projects.astro";
import Contact from "../../components/Contact.astro";
import Footer from "../../components/Footer.astro";
import { languages, type Lang } from "../../data/site";

export function getStaticPaths() {
  // El español no lleva prefijo en la URL; el resto de idiomas sí (/en/)
  return languages.map((lang) => ({ params: { lang: lang === "es" ? undefined : lang }, props: { lang } }));
}

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Layout lang={lang} page="/">
  <Header lang={lang} page="/" />
  <main id="contenido">
    <Hero lang={lang} />
    <Experience lang={lang} />
    <Projects lang={lang} />
    <Contact lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
