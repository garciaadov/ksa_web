---
// Layout base: <head> con SEO / Open Graph, script anti-parpadeo del tema y animaciones de scroll.
import "../styles/global.css";
import { site } from "../data/site";
import { withBase } from "../lib/url";

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(withBase("og.png"), Astro.site);
const accentVars = `--accent-light:${site.accent.light};--accent-dark:${site.accent.dark}`;
---

<!doctype html>
<html lang="es" style={accentVars}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical} />

    <!-- Iconos (generados en src/pages/*.ts a partir de site.ts) -->
    <link rel="icon" href={withBase("favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase("apple-touch-icon.png")} />

    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#FBFBFD" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0B0B0C" media="(prefers-color-scheme: dark)" />

    <!-- Open Graph / redes sociales -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.title} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="generator" content={Astro.generator} />

    <!-- Aplica el tema antes del primer pintado para evitar parpadeo.
         Prioridad: elección guardada > preferencia del sistema. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add("js");
        var t = null;
        try {
          t = localStorage.getItem("theme");
        } catch (e) {}
        if (t !== "light" && t !== "dark") {
          t = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        d.setAttribute("data-theme", t);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />

    <script>
      // Fade-in al entrar en pantalla. Sin IntersectionObserver o con movimiento
      // reducido, todo se muestra directamente.
      const items = document.querySelectorAll<HTMLElement>("[data-reveal]");
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (reduce || !("IntersectionObserver" in window)) {
        items.forEach((el) => el.classList.add("is-visible"));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.12 },
        );
        items.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
